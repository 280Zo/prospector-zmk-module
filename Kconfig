config PROSPECTOR_POWER_STATUS
    bool "Report per-half USB power to Prospector"
    depends on ZMK_SPLIT && ZMK_BLE && SOC_NRF52840
    depends on !ZMK_SPLIT_ROLE_CENTRAL || SHIELD_PROSPECTOR_ADAPTER
    default n
    help
      Separate encrypted power-status telemetry. Reports VBUS presence, not
      actual charging or state of charge; leaves standard battery service intact.

config PROSPECTOR_SPLIT_SIDE
    int "Which half this peripheral is (0 unknown, 1 left, 2 right)"
    depends on PROSPECTOR_POWER_STATUS && !ZMK_SPLIT_ROLE_CENTRAL
    range 0 2
    default 0
    help
      Reported to the Prospector dongle so it places each half by side rather
      than by pairing order. Set in each half's shield .conf.

choice PROSPECTOR_STATUS_SCREEN_LAYOUT
    prompt "Status screen layout"
    default PROSPECTOR_STATUS_SCREEN_CLASSIC


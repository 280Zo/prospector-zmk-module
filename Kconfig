    bool "Classic layout"
    help
        Standard Prospector status screen

config PROSPECTOR_STATUS_SCREEN_RADII
    bool "Radii layout"
    help
        Colorful grid layout with rounded widgets

config PROSPECTOR_STATUS_SCREEN_FIELD
    bool "Field layout"
    help
        Minimal layout with flowing typing activity visualization

config PROSPECTOR_STATUS_SCREEN_OPERATOR
    bool "Operator layout"
    help
        Technical and information dense layout

endchoice

choice PROSPECTOR_OPERATOR_THEME
    prompt "Operator colour theme at startup"
    depends on PROSPECTOR_STATUS_SCREEN_OPERATOR
    default PROSPECTOR_OPERATOR_THEME_DEFAULT
    help
      Colours of the Operator status screen when the dongle starts. The theme keys cycle
      through all themes while it runs. Diagnostics and the avatar page keep their own
      colours.


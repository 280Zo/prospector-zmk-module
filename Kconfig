config PROSPECTOR_OPERATOR_CUSTOM_THEME
    bool "Legacy single Custom Operator theme"
    depends on PROSPECTOR_STATUS_SCREEN_OPERATOR
    help
      Legacy compatibility for manually filled 14-colour configurations. Every
      colour must be set or the build stops. New named themes are created with
      the firmware repository's scripts/theme-tweak.py instead. Do not combine
      this option with a generated registry. Dark backgrounds only.

if PROSPECTOR_OPERATOR_CUSTOM_THEME

config PROSPECTOR_OPERATOR_CUSTOM_BG
    hex "Background"
    help
      Screen background, boxes behind the WPM number and layer name, and dark text on
      light fills. Must be dark; 0x000000 recommended (tinted backgrounds look washed
      out on this screen).

config PROSPECTOR_OPERATOR_CUSTOM_TEXT
    hex "Text"
    help
      Layer name, active layer dot and light number text.

config PROSPECTOR_OPERATOR_CUSTOM_MUTED
    hex "Muted text"
    help
      TOP WPM and KEY PRESS labels, balance centre tick, modifier separators; base for
      inactive modifiers and layer dots.

config PROSPECTOR_OPERATOR_CUSTOM_OUTLINE
    hex "Outline"
    help
      Balance bar track.

config PROSPECTOR_OPERATOR_CUSTOM_ACCENT
    hex "Accent"
    help
      WPM bars and the live WPM number.

config PROSPECTOR_OPERATOR_CUSTOM_INFO
    hex "Info"
    help
      TOP WPM and KEY PRESS values, held modifiers.

config PROSPECTOR_OPERATOR_CUSTOM_MARKER
    hex "Balance marker"
    help
      Balance bar marker.

config PROSPECTOR_OPERATOR_CUSTOM_CAPS
    hex "Caps"
    help
      CAPS WORD and CAPS LOCK when on.

config PROSPECTOR_OPERATOR_CUSTOM_BRIGHT
    hex "Brightness"
    help
      Brightness level shown in the modifier row.

config PROSPECTOR_OPERATOR_CUSTOM_BATTERY
    hex "Battery"
    help
      Battery ring and number box.

config PROSPECTOR_OPERATOR_CUSTOM_LOW
    hex "Low battery"
    help
      Battery ring and number box when low.

config PROSPECTOR_OPERATOR_CUSTOM_USB
    hex "USB"
    help
      USB button: active fill, inactive outline.

config PROSPECTOR_OPERATOR_CUSTOM_BLE
    hex "BLE"
    help
      BLE button: active fill, inactive outline.

config PROSPECTOR_OPERATOR_CUSTOM_SLOT

choice PROSPECTOR_STATUS_SCREEN_LAYOUT
    prompt "Status screen layout"
    default PROSPECTOR_STATUS_SCREEN_CLASSIC

config PROSPECTOR_STATUS_SCREEN_CLASSIC
    bool "Classic layout"
    help
        Standard Prospector status screen

config PROSPECTOR_STATUS_SCREEN_RADII
    bool "Radii layout"
    help
        Colorful grid layout with rounded widgets

config PROSPECTOR_STATUS_SCREEN_FIELD
    bool "Field layout"
    help
        Minimal layout with flowing typing activity visualization

config PROSPECTOR_STATUS_SCREEN_OPERATOR
    bool "Operator layout"
    help
        Technical and information dense layout

endchoice

config PROSPECTOR_ROTATE_DISPLAY_180
    bool "Rotate the display 180 degrees"
    default n

config PROSPECTOR_ENABLE_DIAGNOSTICS_PAGE
    bool "Enable Prospector diagnostics display page"
    default n
    help
      Enable the swipe/key-selectable diagnostics display page.

config PROSPECTOR_ENABLE_AVATAR_PAGE
    bool "Enable Keyboard Knight avatar display page"
    default n
    help
      Enable the swipe/key-selectable Keyboard Knight avatar page.

config PROSPECTOR_AVATAR_SHOW_KEYBOARD_KNIGHT
    bool "Show Keyboard Knight avatar art"
    default y
    depends on PROSPECTOR_ENABLE_AVATAR_PAGE
    help
      Show the Keyboard Knight on the avatar page. Disable this to keep the
      avatar page and extras available without linking the Keyboard Knight art.

config PROSPECTOR_AVATAR_USE_PIXEL_ART
    bool "Use generated indexed pixel art for the avatar page"
    default y
    depends on PROSPECTOR_AVATAR_SHOW_KEYBOARD_KNIGHT
    help
      When enabled, the avatar page draws generated WASD knight pixel art
      from a compact 4-bit indexed asset through a custom LVGL draw
      callback. When disabled, the page uses a lightweight primitive fallback.

config PROSPECTOR_ENABLE_AVATAR_EXTRA
    bool "Enable Keyboard Knight extra"
    default n
    depends on PROSPECTOR_ENABLE_AVATAR_PAGE

config PROSPECTOR_SHOW_MODIFIERS
    bool "Display modifier key indicators (Cmd, Opt, Ctrl, Shift)"
    default y

config PROSPECTOR_SHOW_INACTIVE_MODIFIERS
    bool "Show inactive modifier indicators (dim when not pressed)"
    default y
    depends on PROSPECTOR_SHOW_MODIFIERS
    help
      When enabled, inactive modifiers are shown with a dim color.
      When disabled, inactive modifiers are hidden completely.
      Only affects classic and field layouts.

config PROSPECTOR_MODIFIER_ORDER
    string "Modifier display order"
    default "GACS"
    depends on PROSPECTOR_SHOW_MODIFIERS
    help
      Order of modifier indicators. Use exactly 4 characters:
      G=GUI/Cmd, A=Alt/Opt, C=Control, S=Shift.
      Each character must appear exactly once.

choice PROSPECTOR_MODIFIER_OS
    prompt "Modifier key style"
    default PROSPECTOR_MODIFIER_OS_MAC
    depends on PROSPECTOR_SHOW_MODIFIERS

config PROSPECTOR_MODIFIER_OS_GENERIC
    bool "Generic (CTRL, ALT, GUI, SHFT)"

config PROSPECTOR_MODIFIER_OS_WINDOWS
    bool "Windows"

config PROSPECTOR_MODIFIER_OS_MAC
    bool "Mac"

endchoice

config PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR
    bool "Use ambient light sensor for auto brightness"
    default y

rsource "drivers/sensor/apds9960/Kconfig"

config PROSPECTOR_FIXED_BRIGHTNESS
    int "Fixed display brightness"
    default 50
    range 1 100
    depends on !PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR

config PROSPECTOR_BRIGHTNESS_STEP
    int "Display brightness step"
    default 10
    range 1 100
    help
      Percentage-point step used by Prospector display brightness key bindings.

config PROSPECTOR_LAYER_NAME_UPPERCASE
    bool "Display layer names in uppercase"
    default y
    help
      When enabled, layer names will be converted to uppercase for display.
